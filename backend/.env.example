# FastAPI
PROJECT_NAME="Portal da Obra API"
ENVIRONMENT="dev"
SECRET_KEY="super-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Banco
DATABASE_URL="postgresql+psycopg2://portal:portal@localhost:5432/portal_obra"

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15

# Ingestão SharePoint (somente leitura)
# mock: gera arquivos simulados para demonstração
# mirror: lê somente arquivos de um espelho local sem alterar origem
SHAREPOINT_MODE="mock"
SHAREPOINT_SITE_URL=""
SHAREPOINT_LIBRARY=""
SHAREPOINT_USERNAME=""
SHAREPOINT_PASSWORD=""
